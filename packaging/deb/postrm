#!/bin/sh
# Sentinel : après le retrait. « purge » efface aussi les données de visage et la clé.
set -e
case "$1" in
    remove|purge)
        # Caches créés par Python à l'exécution (__pycache__), qui n'appartiennent pas
        # au paquet : sans eux, dpkg aurait déjà supprimé ces dossiers.
        rm -rf /opt/sentinel
        [ -x /usr/share/gdm/generate-config ] && /usr/share/gdm/generate-config >/dev/null 2>&1 || true
        [ -d /run/systemd/system ] && systemctl daemon-reload || true
        ;;
esac
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/sentinel /etc/systemd/system/sentineld.service.d
    rm -f /etc/credstore.encrypted/sentinel-master-key /etc/credstore.encrypted/sentinel-master-key.mode
    [ -d /run/systemd/system ] && systemctl daemon-reload || true
fi
exit 0
